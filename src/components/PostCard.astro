---
import { Image } from 'astro:assets';
import {
  decodeWordPressSlug,
  getFeaturedImage,
  getPostCategories,
  type WordPressPost,
} from '../lib/wordpress/client';
import { stripHtml } from '../lib/text';

interface Props {
  post: WordPressPost;
}

const { post } = Astro.props;
const image = getFeaturedImage(post);
const categories = getPostCategories(post);
const title = stripHtml(post.title.rendered);
const excerpt = stripHtml(post.excerpt.rendered);
const postUrl = `/${decodeWordPressSlug(post.slug)}/`;
---

<article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
  {image && (
    <Image
      src={image.source_url}
      alt={image.alt_text || title}
      width={image.media_details?.width ?? 1200}
      height={image.media_details?.height ?? 800}
      class="aspect-[3/2] w-full object-cover"
      loading="lazy"
    />
  )}
  <div class="p-5">
    <time datetime={post.date} class="text-sm text-slate-500">
      {new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(new Date(post.date))}
    </time>
    {categories.length > 0 && <p class="mt-2 text-xs tracking-wide text-slate-500">{categories.map((category) => category.name).join(' / ')}</p>}
    <h2 class="mt-2 text-xl font-semibold leading-snug">
      <a href={postUrl}>{title}</a>
    </h2>
    {excerpt && <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{excerpt}</p>}
  </div>
</article>
