---
import BaseLayout from './BaseLayout.astro';
import type { PageSeo } from '../lib/seo';

interface Props extends PageSeo {}
---

<BaseLayout {...Astro.props} theme="jiji-style">
  <Fragment slot="header">
    <div class="mx-auto w-full max-w-[1280px] px-5 md:px-8">
      <div class="flex items-end justify-between gap-8 py-7 md:py-10">
        <div>
          <a class="inline-block font-jiji-serif text-5xl font-bold leading-none no-underline md:text-6xl" href="/examples/jiji-style/">
            JiJi Style
          </a>
          <p class="mt-3 text-sm tracking-wide text-jiji-muted md:text-base">Classic menswear and daily style</p>
        </div>
        <p class="hidden max-w-[20rem] text-right text-xs leading-5 tracking-wide text-jiji-muted md:block">
          A personal journal about clothing, style and living well.
        </p>
      </div>
      <nav class="overflow-x-auto border-t border-jiji-border" aria-label="カテゴリー">
        <ul class="flex min-w-max gap-7 py-4 text-xs tracking-[0.14em] uppercase">
          <li><a class="no-underline hover:opacity-50" href="/examples/jiji-style/">Latest</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/daily-style/">Daily Style</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/jackets-suits/">Jackets &amp; Suits</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/shoes/">Shoes</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/shirts/">Shirts</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/ties/">Ties</a></li>
          <li><a class="no-underline hover:opacity-50" href="/categories/coats/">Coats</a></li>
        </ul>
      </nav>
    </div>
  </Fragment>

  <slot />

  <Fragment slot="footer">
    <div class="mx-auto w-[min(calc(100%-2.5rem),73.75rem)]">© Y&amp;H Inc. All Rights Reserved.</div>
  </Fragment>
</BaseLayout>
